{
  "name": "prepagent",
  "version": "1.0.0",
  "description": "Preparation Agent - ATS Resume Analyzer",
  "scripts": {
    "dev:all": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/server.js",
    "dev:client": "cd client && npx vite",
    "install:all": "cd server && npm install && cd ../client && npm install",
    "build": "cd client && npx vite build",
    "start": "node server/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.0.0",
    "eslint": "^10.6.0",
    "happy-dom": "^20.14.5",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "cloudinary": "^1.41.3",
    "mongoose": "^9.10.2",
    "multer-storage-cloudinary": "^4.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  }
}

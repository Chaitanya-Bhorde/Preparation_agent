# MongoDB
MONGO_URI=YOUR_MONGO_URI_HERE
MONGODB_URI=YOUR_MONGODB_URI_HERE

# JWT
JWT_SECRET=YOUR_JWT_SECRET_HERE
JWT_EXPIRE=YOUR_JWT_EXPIRE_HERE

# Server
PORT=YOUR_PORT_HERE
NODE_ENV=YOUR_NODE_ENV_HERE
FRONTEND_URL=YOUR_FRONTEND_URL_HERE

# Cloudinary
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME_HERE
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY_HERE
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET_HERE

# LLM
LLM_API_KEY=YOUR_LLM_API_KEY_HERE
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# AI Mock Interview (optional overrides — defaults are sensible)
INTERVIEW_LLM_URL=https://api.groq.com/openai/v1/chat/completions
INTERVIEW_LLM_MODEL=openai/gpt-oss-120b
INTERVIEW_LLM_TIMEOUT_MS=30000
INTERVIEW_LLM_MAX_RETRIES=1
INTERVIEW_LLM_MAX_TOKENS=1100

# Judge0
JUDGE0_API_URL=YOUR_JUDGE0_API_URL_HERE
JUDGE0_API_KEY=YOUR_JUDGE0_API_KEY_HERE

# Debug flags
DEBUG_PDF_EXTRACTION=YOUR_DEBUG_PDF_EXTRACTION_HERE

# Cookie
COOKIE_EXPIRE=YOUR_COOKIE_EXPIRE_HERE

# Piston (optional, used in dev scripts)
PISTON_MOCK=YOUR_PISTON_MOCK_HERE

# ---------------------------------------------------------------------------
# SMTP transport (used by the password-reset flow)
# ---------------------------------------------------------------------------
# Read exclusively from environment variables. Never commit real credentials.
# The reset link is built from FRONTEND_URL (above), e.g.
#   ${FRONTEND_URL}/reset-password/<raw-token>
# Only the SHA-256 of the token is stored in the DB; the raw value travels
# only inside the emailed link.
SMTP_HOST=YOUR_SMTP_HOST_HERE
SMTP_PORT=YOUR_SMTP_PORT_HERE
SMTP_USER=YOUR_SMTP_USER_HERE
SMTP_PASS=YOUR_SMTP_PASS_HERE
SMTP_FROM=YOUR_SMTP_FROM_ADDRESS_HERE
# Optional: plain / ssl / starttls
SMTP_SECURE=YOUR_SMTP_SECURE_FALSE_HERE

# ---------------------------------------------------------------------------
# Password-reset throttling (per IP, reset endpoints only)
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=YOUR_RATE_LIMIT_WINDOW_MS_HERE
RATE_LIMIT_FORGOT_MAX=YOUR_RATE_LIMIT_FORGOT_MAX_HERE
RATE_LIMIT_RESET_MAX=YOUR_RATE_LIMIT_RESET_MAX_HERE